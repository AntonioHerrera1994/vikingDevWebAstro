---
import '../styles/global.css'

import Navbar from '../components/navbar.astro';       // AJUSTA igual que en paginas-web-tijuana.astro
import Footer from '../components/footer.astro';       // AJUSTA
import Cotizador from '../components/contacto.astro';  // AJUSTA
import Faq from '../components/Faq.astro';

import PwSubnav from '../components/paginas-web/PwSubnav.astro';
import PwProceso from '../components/paginas-web/PwProceso.astro';

import CampHero from '../components/campanas/CampHero.astro';
import CampCanales from '../components/campanas/CampCanales.astro';
import CampPlatform from '../components/campanas/CampPlatform.astro';
import CampSearchMock from '../components/campanas/CampSearchMock.astro';
import CampSocialMock from '../components/campanas/CampSocialMock.astro';
import CampCombo from '../components/campanas/CampCombo.astro';
import CampInversion from '../components/campanas/CampInversion.astro';

import '../styles/web/pw-shared.css';
import { adMeta, adSubnav, adGoogle, adMetaAds, adCombo, adProceso, adFaq } from '../data/publicidad';

// ── Schema: servicio con sus 3 ofertas + migas de pan ──
const monthly = (name: string, price: number, anchor: string) => ({
  '@type': 'Offer',
  name,
  price,
  priceCurrency: 'MXN',
  url: `${adMeta.url}#${anchor}`,
  priceSpecification: {
    '@type': 'UnitPriceSpecification',
    price,
    priceCurrency: 'MXN',
    unitText: 'MES',
  },
});

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Publicidad en Google y Facebook en Tijuana',
  serviceType: 'Gestión de campañas de Google Ads y Meta Ads',
  description: adMeta.description,
  url: adMeta.url,
  areaServed: { '@type': 'City', name: 'Tijuana' },
  provider: {
    '@type': 'ProfessionalService',
    name: 'VikingDev',
    url: 'https://vikingdevtj.com/',
    telephone: '+52-663-247-7816',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Gestión de campañas publicitarias',
    itemListElement: [
      monthly('Gestión de Google Ads', adGoogle.priceValue, adGoogle.id),
      monthly('Gestión de Meta Ads (Facebook e Instagram)', adMetaAds.priceValue, adMetaAds.id),
      monthly('Gestión de Meta Ads + Google Ads', adCombo.priceValue, 'combo'),
    ],
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://vikingdevtj.com/' },
    { '@type': 'ListItem', position: 2, name: 'Publicidad en Google y Facebook', item: adMeta.url },
  ],
};
---

<html lang="es">
<head>
    <!-- Meta básicos -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Principal (ESPECÍFICO PARA ADS) -->
    <title>Agencia de Publicidad Digital en Tijuana | Google y Meta Ads</title>
    <meta name="description" content="Agencia de Google Ads y Meta Ads en Tijuana. Creamos y optimizamos tus campañas en Google, Facebook e Instagram. Gestión desde $1,500 MXN + IVA al mes.">
    <link rel="canonical" href="https://vikingdevtj.com/publicidad-google-meta/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vikingdevtj.com/publicidad-google-meta/">
    <meta property="og:title" content="Agencia de Publicidad Digital en Tijuana | Google y Meta Ads">
    <meta property="og:description" content="Agencia de Google Ads y Meta Ads en Tijuana. Creamos y optimizamos tus campañas en Google, Facebook e Instagram. Gestión desde $1,500 MXN + IVA al mes.">
    <meta property="og:image" content="https://raw.githubusercontent.com/AntonioHerrera1994/vikingDevWebAstro/main/src/assets/d-web.webp">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="es_MX">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://vikingdevtj.com/publicidad-google-meta/">
    <meta name="twitter:title" content="Agencia de Publicidad Digital en Tijuana | Google y Meta Ads">
    <meta name="twitter:description" content="Agencia de Google Ads y Meta Ads en Tijuana. Creamos y optimizamos tus campañas en Google, Facebook e Instagram. Gestión desde $1,500 MXN + IVA al mes.">
    <meta name="twitter:image" content="https://raw.githubusercontent.com/AntonioHerrera1994/vikingDevWebAstro/main/src/assets/d-web.webp">
    
    <!-- Icons y Theme -->
    <link rel="icon" type="image/svg+xml" href="/vikingdev.svg" />
    <meta name="theme-color" content="#5B4FFF">
    
    <!-- Preconnects (CRITICAL para performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://static.hotjar.com">
    
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SWSRTQDPPF"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-SWSRTQDPPF');
    </script>
    
    <!-- Hotjar -->
    <script is:inline>
        (function(h,o,t,j,a,r){
            h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
            h._hjSettings={hjid:6369460,hjsv:6};
            a=o.getElementsByTagName('head')[0];
            r=o.createElement('script');r.async=1;
            r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
            a.appendChild(r);
        })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1613079279881647');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1613079279881647&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->

        <!-- ✅ Schema Markup: Service + BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- ✅ Schema Markup: FAQPage (opcional) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: adFaq.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q, // o faq.question, dependiendo de tu data
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a, // o faq.answer
        },
      })),
    })} />
</head>

  <body>
    <Navbar />

    <main>
      <CampHero />
      <PwSubnav items={adSubnav} />
      <CampCanales />

      <CampPlatform data={adGoogle}>
        <CampSearchMock slot="visual" />
      </CampPlatform>

      <CampPlatform data={adMetaAds} reverse>
        <CampSocialMock slot="visual" />
      </CampPlatform>

      <CampCombo />
      <CampInversion />
      <PwProceso label={adProceso.label} data={adProceso} />
      <Cotizador />
      <Faq title={adFaq.title} subtitle={adFaq.subtitle} faqs={adFaq.faqs} />
    </main>

    <Footer />
  </body>
</html>
