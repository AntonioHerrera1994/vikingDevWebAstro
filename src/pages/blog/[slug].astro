---
import '../../styles/blog.css';
import '../../styles/global.css'

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.excerpt,
  image: post.data.coverImage,
  datePublished: post.data.date.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'VikingDev',
    url: 'https://vikingdevtj.com/',
  },
};
---

<BaseLayout
  title={post.data.metaTitle ?? `${post.data.title} | VikingDev`}
  description={post.data.metaDescription ?? post.data.excerpt}
  image={post.data.coverImage}
  canonicalPath={`/blog/${post.id}`}
  type="article"
  publishedDate={post.data.date}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="blog-post section">
    <div class="container container--narrow">
      <span class="blog-post__category">{post.data.category}</span>
      <h1 class="blog-post__title">{post.data.title}</h1>
      <p class="blog-post__meta">{post.data.date.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })} &middot; {post.data.readTime}</p>

      <div class="blog-post__cover">
        <img src={post.data.coverImage} alt={post.data.coverImageAlt} />
      </div>

      <div class="blog-post__content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>