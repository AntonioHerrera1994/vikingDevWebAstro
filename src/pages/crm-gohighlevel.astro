---
import '../styles/global.css'

import Navbar from '../components/navbar.astro';       // AJUSTA igual que en paginas-web-tijuana.astro
import Footer from '../components/footer.astro';       // AJUSTA
import Cotizador from '../components/contacto.astro';  // AJUSTA
import Faq from '../components/Faq.astro';

import PwSubnav from '../components/paginas-web/PwSubnav.astro';
import PwProceso from '../components/paginas-web/PwProceso.astro';

import HlHero from '../components/gohighlevel/HlHero.astro';
import HlAntesDespues from '../components/gohighlevel/HlAntesDespues.astro';
import HlIncluye from '../components/gohighlevel/HlIncluye.astro';
import HlWhatsapp from '../components/gohighlevel/HlWhatsapp.astro';
import HlAutomatizacion from '../components/gohighlevel/HlAutomatizacion.astro';
import HlIndustrias from '../components/gohighlevel/HlIndustrias.astro';
import HlPrecio from '../components/gohighlevel/HlPrecio.astro';

import '../styles/web/pw-shared.css';
import { hlMeta, hlSubnav, hlPrecio, hlProceso, hlFaq } from '../data/crm-gohighlevel';

// ── Schema: servicio + migas de pan ──
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Implementación y administración de GoHighLevel en español',
  serviceType: 'CRM y automatización de ventas',
  description: hlMeta.description,
  url: hlMeta.url,
  areaServed: { '@type': 'Country', name: 'México' },
  provider: {
    '@type': 'ProfessionalService',
    name: 'VikingDev',
    url: 'https://vikingdevtj.com/',
    telephone: '+52-663-247-7816',
  },
  offers: {
    '@type': 'Offer',
    name: 'CRM GoHighLevel administrado, suscripción incluida',
    price: hlPrecio.priceValue,
    priceCurrency: 'MXN',
    url: `${hlMeta.url}#precio`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: hlPrecio.priceValue,
      priceCurrency: 'MXN',
      unitText: 'MES',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://vikingdevtj.com/' },
    { '@type': 'ListItem', position: 2, name: 'CRM GoHighLevel', item: hlMeta.url },
  ],
};
---

<html lang="es">
<head>
    <!-- Meta básicos -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Principal (ESPECÍFICO PARA HIGHLEVEL) -->
    <title>GoHighLevel en Español: CRM y Automatización | VikingDev</title>
    <meta name="description" content="Implementamos GoHighLevel en español: CRM para WhatsApp, automatización de seguimiento, agenda y reseñas en Google. Suscripción incluida. Desde $6,000 MXN + IVA al mes.">
    <link rel="canonical" href="https://vikingdevtj.com/crm-gohighlevel/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vikingdevtj.com/crm-gohighlevel/">
    <meta property="og:title" content="GoHighLevel en Español: CRM y Automatización | VikingDev">
    <meta property="og:description" content="Implementamos GoHighLevel en español: CRM para WhatsApp, automatización de seguimiento, agenda y reseñas en Google. Suscripción incluida. Desde $6,000 MXN + IVA al mes.">
    <meta property="og:image" content="https://raw.githubusercontent.com/AntonioHerrera1994/vikingDevWebAstro/main/src/assets/d-web.webp">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="es_MX">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://vikingdevtj.com/crm-gohighlevel/">
    <meta name="twitter:title" content="GoHighLevel en Español: CRM y Automatización | VikingDev">
    <meta name="twitter:description" content="Implementamos GoHighLevel en español: CRM para WhatsApp, automatización de seguimiento, agenda y reseñas en Google. Suscripción incluida. Desde $6,000 MXN + IVA al mes.">
    <meta name="twitter:image" content="https://raw.githubusercontent.com/AntonioHerrera1994/vikingDevWebAstro/main/src/assets/d-web.webp">
    
    <!-- Icons y Theme -->
    <link rel="icon" type="image/svg+xml" href="/vikingdev.svg" />
    <meta name="theme-color" content="#5B4FFF">
    
    <!-- Preconnects (CRITICAL para performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://static.hotjar.com">
    
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SWSRTQDPPF"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-SWSRTQDPPF');
    </script>
    
    <!-- Hotjar -->
    <script is:inline>
        (function(h,o,t,j,a,r){
            h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
            h._hjSettings={hjid:6369460,hjsv:6};
            a=o.getElementsByTagName('head')[0];
            r=o.createElement('script');r.async=1;
            r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
            a.appendChild(r);
        })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1613079279881647');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1613079279881647&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->

    <!-- ✅ Schema Markup: Service + BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

       <!-- ✅ Schema Markup: FAQPage (opcional pero recomendado) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: hlFaq.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,          // <-- Corregido aquí
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,        // <-- Corregido aquí
        },
      })),
    })} />
</head>

  <body>
    <Navbar />

    <main>
      <HlHero />
      <PwSubnav items={hlSubnav} />
      <HlAntesDespues />
      <HlIncluye />
      <HlWhatsapp />
      <HlAutomatizacion />
      <HlIndustrias />
      <HlPrecio />
      <PwProceso label={hlProceso.label} data={hlProceso} />
      <Cotizador />
      <Faq title={hlFaq.title} subtitle={hlFaq.subtitle} faqs={hlFaq.faqs} />
    </main>

    <Footer />
  </body>
</html>
