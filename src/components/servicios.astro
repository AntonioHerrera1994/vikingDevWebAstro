---
import '../styles/servicios.css'
import CodiceVisual from '../assets/metodo.webp';
import CodiceLogo from '../assets/VECTOR.svg';
---
<section class="codice" aria-labelledby="codice-title">
  <div class="container codice__inner">

    <!-- ─── Columna izquierda: imagen + stat ──────────────── -->
    <div class="codice__visual">

      <img src={CodiceVisual.src} alt="CodiceAgents — panel de agenda, clientes y finanzas" class="codice__img" />

  
    </div>

    <!-- ─── Columna derecha: copy ─────────────────────────── -->
    <div class="codice__copy">

      <!-- Logo CodiceAgents -->
      <a
        href="https://codiceagents.com"
        class="codice__logo-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar CodiceAgents — agente de IA para citas, clientes y finanzas"
      >
        <img src={CodiceLogo.src} alt="CodiceAgents" class="codice__logo" />
      </a>

      <!-- Label -->
      <span class="codice__label">Un Agente de IA para tu Negocio</span>

      <!-- H2 -->
      <h2 class="codice__title" id="codice-title">
        Tú atiendes a tus clientes.<br />
        El agente administra tu negocio.
      </h2>

      <!-- Descripción -->
      <p class="codice__desc">
        Una plataforma de IA en español que une agenda, clientes y finanzas en
        un solo flujo conversacional. Hablas con naturalidad y el agente
        ejecuta la acción — sin formularios eternos ni pantallas densas.
      </p>



      <!-- Los 4 agentes -->
      <div class="codice__benefits">

        <div class="codice__benefit">
          <span class="codice__benefit-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </span>
          <div>
            <p class="codice__benefit-title">Agente de Agenda</p>
            <p class="codice__benefit-desc">Agenda, cobra y reorganiza citas hablando.</p>
          </div>
        </div>

        <div class="codice__benefit">
          <span class="codice__benefit-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </span>
          <div>
            <p class="codice__benefit-title">Agente Financiero</p>
            <p class="codice__benefit-desc">Tus números del día, sin abrir Excel.</p>
          </div>
        </div>

        <div class="codice__benefit">
          <span class="codice__benefit-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
          </span>
          <div>
            <p class="codice__benefit-title">Agente de Setup</p>
            <p class="codice__benefit-desc">Horarios, equipo y servicios en minutos.</p>
          </div>
        </div>

        <div class="codice__benefit">
          <span class="codice__benefit-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </span>
          <div>
            <p class="codice__benefit-title">Agente de Clientes</p>
            <p class="codice__benefit-desc">Directorio e historial siempre al día.</p>
          </div>
        </div>

      </div>

      <!-- CTA general -->
      <a
        href="https://codiceagents.com"
        class="codice__cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conocer CodiceAgents
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>

    </div>
  </div>
</section>

<script>
    import '../scripts/ikari.js';
</script>