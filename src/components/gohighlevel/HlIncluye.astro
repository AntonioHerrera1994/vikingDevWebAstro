---
// Reutiliza el diseño bento de PwBeneficios (pw-beneficios.css / pw-beneficios.js)
import '../../styles/web/pw-beneficios.css';
import { hlIncluye as d, type HlIcon } from '../../data/crm-gohighlevel';

const icons: Record<HlIcon, string> = {
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
  pipeline: '<rect x="3" y="4" width="5" height="16" rx="1.5"/><rect x="10" y="4" width="5" height="10" rx="1.5"/><rect x="17" y="4" width="4" height="6" rx="1.5"/>',
  inbox: '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5h13L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  form: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  star: '<path d="m12 2 3 6.5 7 .8-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.8z"/>',
  funnel: '<path d="M3 4h18l-7 9v6l-4 2v-8z"/>',
  chart: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"/>',
};
---

<section class="pw-benefits section" id="incluye" aria-labelledby="hl-incluye-title" data-pw-benefits>
  <div class="container">

    <header class="pw-benefits__header" data-reveal>
      <span class="section-label">{d.label}</span>
      <h2 class="section-title" id="hl-incluye-title">{d.h2}</h2>
      <p class="section-subtitle">{d.intro}</p>
    </header>

    <ul class="pw-benefits__grid">
      {d.items.map((b, i) => (
        <li class:list={['pw-benefits__card glass-panel', { 'pw-benefits__card--wide': i === 0 }]} data-reveal data-spotlight>
          <span class="pw-benefits__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
          </span>
          <h3 class="pw-benefits__title">{b.title}</h3>
          <p class="pw-benefits__text">{b.text}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<script>
  import '../../scripts/components/pw-beneficios.js';
</script>
