---
import '../../styles/web/hl-hero.css';
import { hlHero } from '../../data/crm-gohighlevel';

const columns = ['Nuevo', 'Contactado', 'Cita', 'Ganado'];
---

<section class="hl-hero hero-gradient" aria-labelledby="hl-hero-title">
  <div class="container hl-hero__inner">

    <!-- ── Copy ─────────────────────────────────────────── -->
    <div class="hl-hero__copy">
      <nav class="hl-hero__crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">CRM GoHighLevel</span>
      </nav>

      <h1 class="hl-hero__h1" id="hl-hero-title">
        {hlHero.h1Main}
        <span class="hl-hero__accent">{hlHero.h1Accent}</span>
      </h1>

      <p class="hl-hero__intro">{hlHero.intro}</p>

      <ul class="hl-hero__chips" aria-label="Datos clave">
        {hlHero.chips.map((chip) => <li class="hl-hero__chip">{chip}</li>)}
      </ul>

      <div class="hl-hero__actions">
        <a href="#cotizador" class="btn btn--primary" data-quoter-select="CRM GoHighLevel">Solicita una demo</a>
        <a href="#incluye" class="btn btn--outline">Qué incluye</a>
      </div>

      <p class="hl-hero__proof">
        <span class="hl-hero__proof-dot" aria-hidden="true"></span>
        {hlHero.proof}
      </p>
    </div>

    <!-- ── Visual: pipeline donde un lead avanza solo ───── -->
    <div class="hl-hero__visual" aria-hidden="true" data-hl-hero-visual>
      <div class="hl-hero__glow"></div>

      <div class="hl-hero__board glass-panel">
        <div class="hl-hero__board-head">
          <span class="hl-hero__board-title">Pipeline de ventas</span>
          <span class="hl-hero__board-live">En vivo</span>
        </div>

        <div class="hl-hero__cols">
          {columns.map((col, i) => (
            <div class="hl-hero__col">
              <span class="hl-hero__col-name">{col}</span>
              <span class="hl-hero__ghost"></span>
              {i % 2 === 0 && <span class="hl-hero__ghost hl-hero__ghost--short"></span>}
            </div>
          ))}
          <div class="hl-hero__lead">
            <span class="hl-hero__avatar">MG</span>
            <span class="hl-hero__lead-text">
              <strong>María G.</strong>
              <small>Limpieza dental</small>
            </span>
          </div>
        </div>
      </div>

      <div class="hl-hero__toast hl-hero__toast--wa glass-panel">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5z"/></svg>
        WhatsApp enviado
      </div>
      <div class="hl-hero__toast hl-hero__toast--cal glass-panel">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        Cita confirmada
      </div>
      <div class="hl-hero__toast hl-hero__toast--star glass-panel">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3 6.5 7 .8-5.2 4.8 1.5 7L12 17.6 5.7 21l1.5-7L2 9.3l7-.8z"/></svg>
        Nueva reseña en Google
      </div>
    </div>

  </div>
</section>

<script>
  import '../../scripts/components/hl-hero.js';
</script>
