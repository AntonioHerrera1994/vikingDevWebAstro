---
import '../styles/navbar.css'
import ImageLogo from '../assets/vikingdev-logo.webp';

// Páginas de servicio del dropdown (edita aquí para agregar más)
const services = [
  {
    href: '/paginas-web/',
    title: 'Páginas web',
    desc: 'Landing pages, sitios completos y tiendas en línea',
    price: 'Desde $6,000',
    icon: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8M12 18v3"/>',
  },
  {
    href: '/publicidad-google-meta/',
    title: 'Google y Meta Ads',
    desc: 'Campañas en Google, Facebook e Instagram',
    price: 'Desde $1,500/mes',
    icon: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  },
  {
    href: '/crm-gohighlevel/',
    title: 'CRM GoHighLevel',
    desc: 'Seguimiento automático, WhatsApp y reseñas',
    price: '$6,000/mes',
    icon: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/><path d="M19 4.5 21 6.5M5 4.5 3 6.5"/>',
  },
];

// Normaliza la ruta actual para marcar la página activa
const path = Astro.url.pathname.replace(/\/?$/, '/');
const onService = services.some((s) => s.href === path);

// En páginas con cotizador se queda en la misma página; en el resto lleva al home
const pagesWithQuoter = ['/', ...services.map((s) => s.href)];
const quoterHref = pagesWithQuoter.includes(path) ? '#cotizador' : '/#cotizador';
---

<nav id="main-nav" class="nav" aria-label="Navegación principal">
  <div class="container nav__inner">

    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="VikingDev — Ir al inicio">
      <img
        src={ImageLogo.src}
        width="150"
        height={Math.round((ImageLogo.height / ImageLogo.width) * 150)}
        alt="VikingDev, agencia de marketing digital en Tijuana"
      />
    </a>

    <!-- Links desktop -->
    <ul class="nav__links" role="list">

      <!-- Servicios (dropdown) -->
      <li class="nav__dd" data-nav-dd>
        <button
          type="button"
          class:list={['nav__link nav__dd-trigger', { 'nav__link--active': onService }]}
          aria-expanded="false"
          aria-controls="nav-dd-servicios"
          data-nav-dd-trigger
        >
          Servicios
          <svg class="nav__dd-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <div class="nav__dd-panel" id="nav-dd-servicios" data-nav-dd-panel>
          <ul class="nav__dd-list" role="list">
            {services.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="nav__dd-item"
                  aria-current={s.href === path ? 'page' : undefined}
                >
                  <span class="nav__dd-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                  </span>
                  <span class="nav__dd-text">
                    <span class="nav__dd-title">{s.title}</span>
                    <span class="nav__dd-desc">{s.desc}</span>
                  </span>
                  <span class="nav__dd-price">{s.price}</span>
                </a>
              </li>
            ))}
          </ul>

          <div class="nav__dd-foot">
            <a href="/#servicios" class="nav__dd-all">Ver todos los servicios</a>
            <a href={quoterHref} class="nav__dd-quote">
              Cotiza gratis
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      </li>

      <li><a href="/#proyectos" class="nav__link">Proyectos</a></li>
      <li><a href={quoterHref} class="nav__link">Cotizador</a></li>
      <li><a href="/#paquetes" class="nav__link">Paquetes</a></li>
      <li><a href="/blog" class="nav__link">Blog</a></li>
      <li><a href="https://codiceagents.com/" class="nav__link">CodiceAgents</a></li>
      <li><a href="https://amigo-pro.com/" class="nav__link">Amigo Pro</a></li>
    </ul>

    <!-- CTA desktop -->
    <a href={quoterHref} class="btn btn--dark nav__cta">
      Cotiza Gratis
    </a>

    <!-- Hamburger mobile -->
    <button
      id="nav-hamburger"
      class="nav__hamburger"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
      type="button"
    >
      <span class="nav__bar" aria-hidden="true"></span>
      <span class="nav__bar" aria-hidden="true"></span>
      <span class="nav__bar" aria-hidden="true"></span>
    </button>

  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="nav__mobile"
    role="dialog"
    aria-modal="true"
    aria-label="Menú móvil"
    aria-hidden="true"
  >
    <ul class="nav__mobile-list" role="list">

      <!-- Servicios (acordeón) -->
      <li class:list={['nav__mobile-acc', { 'is-open': onService }]} data-nav-acc>
        <button
          type="button"
          class="nav__mobile-link nav__mobile-acc-trigger"
          aria-expanded={onService ? 'true' : 'false'}
          aria-controls="nav-acc-servicios"
          data-nav-acc-trigger
        >
          Servicios
          <svg class="nav__dd-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="nav__mobile-acc-panel" id="nav-acc-servicios" data-nav-acc-panel>
          <ul class="nav__mobile-sub" role="list">
            {services.map((s) => (
              <li>
                <a href={s.href} class="nav__mobile-sublink" aria-current={s.href === path ? 'page' : undefined}>
                  <span class="nav__dd-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                  </span>
                  <span class="nav__dd-text">
                    <span class="nav__dd-title">{s.title}</span>
                    <span class="nav__dd-desc">{s.price}</span>
                  </span>
                </a>
              </li>
            ))}
            <li><a href="/#servicios" class="nav__mobile-sublink nav__mobile-sublink--all">Ver todos los servicios</a></li>
          </ul>
        </div>
      </li>

      <li><a href="/#proyectos" class="nav__mobile-link">Proyectos</a></li>
      <li><a href={quoterHref} class="nav__mobile-link">Cotizador</a></li>
      <li><a href="/#paquetes" class="nav__mobile-link">Paquetes</a></li>
      <li><a href="/blog" class="nav__mobile-link">Blog</a></li>
      <li><a href="https://codiceagents.com/" class="nav__mobile-link">CodiceAgents</a></li>
      <li><a href="https://amigo-pro.com/" class="nav__mobile-link">Amigo Pro</a></li>
    </ul>
    <a href={quoterHref} class="btn btn--primary nav__mobile-cta">
      Cotiza Tu Proyecto Gratis →
    </a>
  </div>
</nav>

	<script>
			import "../scripts/menu.js"
		</script>