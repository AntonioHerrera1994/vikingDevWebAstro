---
import '../styles/experienciacv.css'

const EXPERIENCIA = [
   {
    empresa: "Smart Marketing / Freelance",
    periodo: "2026 - Actualidad",
    rol: "Administrador HighLevel",
    activo: false,
    logros: [
      "Manejo de cuentas de HIghLevel para clientes de la agencia (automatizaciones, formularios, mensajes, contactos, pipelines).",
      "Creación de landing pages con formularios y requerimientos especificos dentro de Highlevel",
    ],
  },
    {
    empresa: "Define Creative Studio / Freelance",
    periodo: "2024 - 2026",
    rol: "Desarrollo Web / Especialista de ads",
    activo: false,
    logros: [
      "Desarrollo y mantenimiento de sitios web para diferentes empresas y negocios en Wordpress y Astro.",
      "Creación y administración de ampañas publicitarias en Meta y Google",
      "Configuración y manejo de CRM (Hubspoy y HighLevel)"
    ],
  },
  
  {
    empresa: "VikingDev / Freelance",
    periodo: "2022 - Actualidad",
    rol: "Desarrollo Web",
    activo: false,
    logros: [
      "Desarrollo y mantenimiento de sitios web para diferentes empresas y negocios.",
      "Campañas en Meta y Google Ads.",
      "Configuración y manejo de diferentes CRM",
      "Aplicaciones web a la medida",
    ],
  },
  {
    empresa: "Empresa de inversión",
    periodo: "2022 - 2026",
    rol: "Desarrollo Web / Web Master",
    activo: true,
    logros: [
      "Desarrollo y mantenimiento de los sitios web en Wordpress y React.",
      "Administrador de Hubspot",
      "Administrador de HighLevel",
      "Administración de servicios de host, dominios redirecciones y servidores.",
    ],
  },
  {
    empresa: "Gas Silza",
    periodo: "2022",
    rol: "Desarrollo Web / Desarrollo de Software",
    activo: false,
    logros: [
      "Mantenimiento al sitio web de la empresa con HTML.",
      "Desarrollo de sistema de gestión e inventario interno en C#.",
      "Soporte técnico a diferentes áreas.",
    ],
  },

    {
    empresa: "Grupo Concordia",
    periodo: "2019 - 2022",
    rol: "Desarrollo Web / Web Master",
    activo: false,
    logros: [
      "Mantenimiento al sitio web de la empresa en Wordpress.",
      "Administración de CRM Zoho",
      "Creación y administración de ampañas publicitarias en Meta y Google",
    ],
  },
];
---

<section class="experience" id="experiencia">
  <div class="experience__container">

    <h2 class="experience__title">
      <span class="experience__title-bar" aria-hidden="true"></span>
      Experiencia Relevante
    </h2>

    <div class="experience__list">
      {EXPERIENCIA.map((item) => (
        <div class="experience__row">
          <div class="experience__meta">
            <p class="experience__company">{item.empresa}</p>
            <p class="experience__period">{item.periodo}</p>
          </div>

          <div class:list={["experience__card", { "experience__card--active": item.activo }]}>
            <h3 class="experience__role">{item.rol}</h3>
            <ul class="experience__achievements">
              {item.logros.map((logro) => (
                <li class="experience__achievement">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="9 12 11 14 15 10" />
                  </svg>
                  <span>{logro}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
    import "../scripts/experienciacv"
</script>