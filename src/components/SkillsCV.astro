---
import '../styles/habilidadescv.css'

const MARKETING_DISENO = ["Meta Ads", "Google Ads", "Google Analytics", "SEO", "Google Search Console"];
const DESARROLLO = [
  "HTML / CSS",
  "JavaScript",
  "PHP",
  "Astro",
  "React",
  "WordPress",
      "Squarespace",
        "Netlify",
          "Vercel",


];
const BACKEND = [
"C#", "PHP", "Python", "Node.js", "SQL", "Supabase",


];

const CRM = [ 
  "GoHighLevel", "HubSpot", "Zoho CRM", "Kommo", "DNS Administration"
];
const Idiomas = ["Español - 100%", "Inglés- 50%"];
---

<section class="skills" id="habilidades">
  <div class="skills__container">

    <h2 class="skills__title">
      <span class="skills__title-bar" aria-hidden="true"></span>
      Habilidades
    </h2>

    <div class="skills__grid">
    
      <div class="skills__column">
        <h3 class="skills__column-title">Desarrollo Frontend & CMS</h3>
        <ul class="skills__list">
          {DESARROLLO.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>

         <div class="skills__column">
        <h3 class="skills__column-title">Desarrollo Backend & DB</h3>
        <ul class="skills__list">
          {BACKEND.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>

       <div class="skills__column">
        <h3 class="skills__column-title">MarTech & CRM</h3>
        <ul class="skills__list">
          {CRM.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>
       <div class="skills__column">
        <h3 class="skills__column-title">Marketing & Analytics</h3>
        <ul class="skills__list">
          {MARKETING_DISENO.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>


       <div class="skills__column">
        <h3 class="skills__column-title">Idiomas</h3>
        <ul class="skills__list">
          {Idiomas.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>

    
    </div>

  </div>
</section>