---
import '../styles/habilidadescv.css'

const MARKETING_DISENO = ["Canva", "Go HighLevel", "Hubspot", "Go HighLevel", "Kommo", "Zoho", "Meta Ads", "Google Analytics", "Google Search Console",];
const DESARROLLO = [
  "HTML / CSS",
  "JavaScript",
  "C#",
  "PHP",
  "Astro",
  "React",
  "Node Js",
  "WordPress",
  "SQL",
  "Python",
    "SEO",
      "Squarespace",
        "Netlify",
          "Vercel",
            "Supabase",
             "DNS Admin",


];
const Idiomas = ["Español - 100%", "Inglés- 50%"];
---

<section class="skills" id="habilidades">
  <div class="skills__container">

    <h2 class="skills__title">
      <span class="skills__title-bar" aria-hidden="true"></span>
      Habilidades
    </h2>

    <div class="skills__grid">
    
      <div class="skills__column">
        <h3 class="skills__column-title">Desarrollo</h3>
        <ul class="skills__list">
          {DESARROLLO.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>

       <div class="skills__column">
        <h3 class="skills__column-title">Otros</h3>
        <ul class="skills__list">
          {MARKETING_DISENO.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>


       <div class="skills__column">
        <h3 class="skills__column-title">Idiomas</h3>
        <ul class="skills__list">
          {Idiomas.map((item) => (
            <li class="skills__item">{item}</li>
          ))}
        </ul>
      </div>

    
    </div>

  </div>
</section>