---
import '../../styles/web/pw-beneficios.css';
import { pwBeneficios, type PwIcon } from '../../data/paginas-web';

const icons: Record<PwIcon, string> = {
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  phone: '<rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5z"/>',
  chart: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
};
---

<section class="pw-benefits section" id="incluye" aria-labelledby="pw-benefits-title" data-pw-benefits>
  <div class="container">

    <header class="pw-benefits__header" data-reveal>
      <span class="section-label">Qué incluye</span>
      <h2 class="section-title" id="pw-benefits-title">Todo lo que incluye tu página web</h2>
      <p class="section-subtitle">
        Cada paquete trae lo necesario para que tu página atraiga visitas, genere
        confianza y convierta, sin costos ocultos.
      </p>
    </header>

    <ul class="pw-benefits__grid">
      {pwBeneficios.map((b, i) => (
        <li class:list={['pw-benefits__card glass-panel', { 'pw-benefits__card--wide': i === 0 }]} data-reveal data-spotlight>
          <span class="pw-benefits__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
          </span>
          <h3 class="pw-benefits__title">{b.title}</h3>
          <p class="pw-benefits__text">{b.text}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<script>
  import '../../scripts/components/pw-beneficios.js';
</script>
