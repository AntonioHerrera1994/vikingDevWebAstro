---

<section class="pricing section" id="paquetes" aria-labelledby="pricing-title">
  <div class="container">

    <header class="pricing__header">
      <span class="section-label">Paquetes Web</span>
      <h2 class="section-title" id="pricing-title">
        La solución perfecta para tu negocio
      </h2>
      <p class="section-subtitle pricing__subtitle">
        Precios claros, sin letras chiquitas. Elige lo que tu negocio necesita hoy.
      </p>
    </header>

    <nav class="pricing__quicknav" aria-label="Navegación de paquetes">
      <button class="pricing__quicknav-btn is-active" data-target="paquetes-web" type="button">
        Desarrollo Web
      </button>
      <button class="pricing__quicknav-btn" data-target="paquetes-ads" type="button">
        Google & Meta Ads
      </button>
      <button class="pricing__quicknav-btn" data-target="paquetes-crm" type="button">
        CRM HighLevel
      </button>
    </nav>

    <!-- ══ Tabla 1: Desarrollo Web ══════════════════════════════ -->
    <div class="pricing__block" id="paquetes-web">
      <h3 class="pricing__block-title">Desarrollo Web</h3>
      <div class="pricing__grid">
        {webPlans.map((plan) => (
          <div class={`pricing__bar${plan.highlight ? ' pricing__bar--highlight' : ''}`}>
            {plan.highlight && <span class="pricing__bar-badge">★ Más popular</span>}
            <span class="pricing__bar-tag">{plan.tag}</span>
            <h4 class="pricing__bar-label">{plan.label}</h4>
            <p class="pricing__bar-desc">{plan.desc}</p>

            <div class="pricing__bar-price-row">
              <span class="pricing__bar-price">{plan.price}</span>
              <span class="pricing__bar-currency">{plan.currency}</span>
            </div>
            <p class="pricing__bar-period">{plan.period}</p>

            <ul class="pricing__bar-features">
              {plan.features.map((feat) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <a
              href={plan.ctaHref}
              class={`pricing__bar-cta${plan.highlight ? ' pricing__bar-cta--highlight' : ''}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Contratar ${plan.label}`}
            >
              {plan.cta}
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- ══ Tabla 2: Google & Meta Ads ═══════════════════════════ -->
    <div class="pricing__block" id="paquetes-ads">
      <h3 class="pricing__block-title">Google & Meta Ads</h3>
      <div class="pricing__grid">
        {adsPlans.map((plan) => (
          <div class={`pricing__bar${plan.highlight ? ' pricing__bar--highlight' : ''}`}>
            {plan.highlight && <span class="pricing__bar-badge">★ Ahorra más</span>}
            <span class="pricing__bar-tag">{plan.tag}</span>
            <h4 class="pricing__bar-label">{plan.label}</h4>
            <p class="pricing__bar-desc">{plan.desc}</p>

            <div class="pricing__bar-price-row">
              <span class="pricing__bar-price">{plan.price}</span>
              <span class="pricing__bar-currency">{plan.currency}</span>
            </div>
            <p class="pricing__bar-period">{plan.period}</p>

            <ul class="pricing__bar-features">
              {plan.features.map((feat) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <p class="pricing__bar-note">{plan.note}</p>

            <a
              href={plan.ctaHref}
              class={`pricing__bar-cta${plan.highlight ? ' pricing__bar-cta--highlight' : ''}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Contratar ${plan.label}`}
            >
              {plan.cta}
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- ══ CRM HighLevel — banner único, no es tabla comparativa ═ -->
    <div class="pricing__block" id="paquetes-crm">
      <h3 class="pricing__block-title">CRM HighLevel</h3>
      <div class="pricing__crm-banner">
        <div class="pricing__crm-copy">
          <span class="pricing__bar-tag pricing__bar-tag--light">{crmPlan.tag}</span>
          <p class="pricing__crm-desc">{crmPlan.desc}</p>
          <ul class="pricing__crm-features">
            {crmPlan.features.map((feat) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="pricing__crm-price-col">  
          <span class="pricing__crm-price">{crmPlan.price}</span>
          <span class="pricing__crm-currency">{crmPlan.currency} {crmPlan.period}</span>
          <p class="pricing__crm-note">{crmPlan.note}</p>
          <a
            href={crmPlan.ctaHref}
            class="pricing__bar-cta pricing__bar-cta--highlight"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contratar CRM HighLevel"
          >
            {crmPlan.cta}
          </a>
        </div>
      </div>
    </div>

    <p class="pricing__note">
      ¿Proyecto especial o a medida?
      <a href="https://wa.link/wnb0m6" class="pricing__note-link" target="_blank" rel="noopener noreferrer">
        Hablemos →
      </a>
    </p>

  </div>
</section>

<script>
  import '../scripts/costos'
</script>