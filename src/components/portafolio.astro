---
import '../styles/portafolio.css'
import { vikingProjects, snitchProjects } from '../data/projects';

const filterOptions = [
  { value: 'todos', label: 'Todos' },
  { value: 'tecnologia', label: 'Tecnología' },
  { value: 'salud', label: 'Salud' },
  { value: 'belleza', label: 'Belleza y Cuidado' },
  { value: 'bienes-raices', label: 'Bienes Raíces' },
  { value: 'transporte', label: 'Transporte' },
  { value: 'educacion', label: 'Educación' },
  { value: 'restaurante', label: 'Restaurante' },
  { value: 'industrial', label: 'Industrial' },
  { value: 'otro', label: 'Otro' },
];

/* Combina ambos portafolios para contar por categoría de forma global */
const allProjects = [...vikingProjects, ...snitchProjects];

const categoryCounts = filterOptions.reduce<Record<string, number>>((acc, opt) => {
  acc[opt.value] =
    opt.value === 'todos'
      ? allProjects.length
      : allProjects.filter((p) => p.filterCategory === opt.value).length;
  return acc;
}, {});
---

<section class="portfolio section" id="proyectos" aria-labelledby="portfolio-title">
  <div class="container">

    <!-- ══ Carrusel 1: VikingDev ══════════════════════════════ -->
    <div class="portfolio__block" data-carousel="vikingdev">

      <div class="portfolio__header">
        <div class="portfolio__header-left">
          <span class="section-label">Portafolio VikingDev</span>
          <h2 class="section-title" id="portfolio-title">Proyectos de páginas web en Tijuana</h2>
          <p class="section-subtitle">      Páginas web, tiendas en línea y landing pages que hemos creado para negocios locales e internacionales.</p>
        </div>
        <div class="portfolio__nav" aria-label="Navegación carrusel VikingDev">
          <div class="portfolio__filter">
            <label class="portfolio__filter-label" for="portfolio-filter-vikingdev">Filtrar por categoría</label>
            <select class="portfolio__filter-select" id="portfolio-filter-vikingdev" data-filter-select>
             {filterOptions.map((opt) => (
    <option value={opt.value}>{opt.label} ({categoryCounts[opt.value]})</option>
  ))}
            </select>
          </div>
          <button class="portfolio__arrow portfolio__arrow--prev" aria-label="Proyecto anterior" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>
          <button class="portfolio__arrow portfolio__arrow--next" aria-label="Siguiente proyecto" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Track -->
      <div class="portfolio__viewport">
        <ul class="portfolio__track" role="list">
          {vikingProjects.map((p) => (
            <li class="portfolio__card" data-id={p.id} data-category={p.filterCategory}>
              <div class="portfolio__img-wrap">
                <img
                  src={p.image}
                  alt={p.imageAlt}
                  class="portfolio__img"
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="300"
                />
              </div>
              <div class="portfolio__card-body">
                <span class="portfolio__category">{p.category}</span>
                <h3 class="portfolio__card-title">{p.title}</h3>
                <p class="portfolio__card-desc">{p.desc}</p>
                <a
                  href={p.url}
                  class="portfolio__link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver sitio web de ${p.title}`}
                >
                  Ver sitio web
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <p class="portfolio__empty" hidden>No hay proyectos en esta categoría por el momento.</p>

      <!-- Dots -->
      <div class="portfolio__dots" aria-label="Posición en el carrusel"></div>
    </div>

    <!-- Divider -->
    <div class="portfolio__divider" aria-hidden="true"></div>

    <!-- ══ Carrusel 2: Snitch Agency ══════════════════════════ -->
    <div class="portfolio__block" data-carousel="snitch">

      <div class="portfolio__header">
        <div class="portfolio__header-left">
          <span class="section-label">Portafolio Snitch Agency</span>
          <h2 class="section-title">Branding y diseño de marca en Tijuana</h2>
          <p class="section-subtitle">Identidad visual, logotipos y contenido creativo desarrollados por nuestro socio Snitch Agency.</p>
        </div>
        <div class="portfolio__nav" aria-label="Navegación carrusel Snitch Agency">
          <div class="portfolio__filter">
            <label class="portfolio__filter-label" for="portfolio-filter-snitch">Filtrar por categoría</label>
            <select class="portfolio__filter-select" id="portfolio-filter-snitch" data-filter-select>
             {filterOptions.map((opt) => (
    <option value={opt.value}>{opt.label} ({categoryCounts[opt.value]})</option>
  ))}
            </select>
          </div>
          <button class="portfolio__arrow portfolio__arrow--prev" aria-label="Proyecto anterior" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>
          <button class="portfolio__arrow portfolio__arrow--next" aria-label="Siguiente proyecto" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="portfolio__viewport">
        <ul class="portfolio__track" role="list">
          {snitchProjects.map((p) => (
            <li class="portfolio__card" data-id={p.id} data-category={p.filterCategory}>
              <div class="portfolio__img-wrap">
                <img
                  src={p.image}
                  alt={p.imageAlt}
                  class="portfolio__img"
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="300"
                />
              </div>
              <div class="portfolio__card-body">
                <span class="portfolio__category">{p.category}</span>
                <h3 class="portfolio__card-title">{p.title}</h3>
                <p class="portfolio__card-desc">{p.desc}</p>
                <a
                  href={p.url}
                  class="portfolio__link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver sitio web de ${p.title}`}
                >
                  Ver sitio web
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <p class="portfolio__empty" hidden>No hay proyectos en esta categoría por el momento.</p>

      <div class="portfolio__dots" aria-label="Posición en el carrusel"></div>
    </div>

  </div>
</section>

<script>
  import "../scripts/drag.js"
</script>